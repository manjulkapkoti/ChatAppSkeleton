   "width": 1060,
   "height": 60,
   "section": "THE ONE TRUST BOUNDARY — every entry point above calls this",
   "role": {
    "title": "is_member()",
    "text": "Every privileged entry point — the handshake and all three REST routes — calls this one function, never re-implementing the rule per route. It's the one file meant to be rewritten for your app (a friends table, a project-members table, a paid-access flag...).",
    "file": "backend/membership.py"
   }
  },
  {
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1090035254,
   "version": 1,
   "versionNonce": 1596987368,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1784619688305,
   "link": null,
   "locked": false,
   "type": "text",
   "id": "m1_txt",
   "x": 74,
   "y": 897.5,
   "width": 1092,
   "height": 35,
   "text": "is_member(room_id, user_id) -> bool\nYour app's own rule plugs in here — a friends table, a project-members table, a paid-access flag — never re-implemented per route.",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "m1",
   "originalText": "is_member(room_id, user_id) -> bool\nYour app's own rule plugs in here — a friends table, a project-members table, a paid-access flag — never re-implemented per route.",
   "lineHeight": 1.25,
   "baseline": 14
  },
  {
   "angle": 0,
