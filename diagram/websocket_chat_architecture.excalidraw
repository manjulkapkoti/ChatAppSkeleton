   "type": "rectangle",
   "id": "o1",
   "x": 90,
   "y": 772,
   "width": 640,
   "height": 62,
   "section": "MESSAGE-LOOP ORDERING RULE",
   "role": {
    "title": "Message loop ordering",
    "text": "Per received frame: rate-limit check first, then validate, then persist, then broadcast (sender's own socket included). Rate-limiting before validation matters — otherwise a flood of invalid/oversized frames never spends any budget.",
    "file": "backend/chat_router.py — the receive loop inside room_socket()"
   }
  },
  {
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 435156599,
   "version": 1,
   "versionNonce": 942108713,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1784619688305,
   "link": null,
   "locked": false,
   "type": "text",
   "id": "o1_txt",
   "x": 90,
   "y": 786.5,
   "width": 640,
   "height": 33,
   "text": "1 rate-limit → 2 validate (non-fatal) → 3 persist → 4 publish (sender included)\nRate-limit BEFORE validating — else a garbage-frame flood dodges the cap entirely.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "o1",
   "originalText": "1 rate-limit → 2 validate (non-fatal) → 3 persist → 4 publish (sender included)\nRate-limit BEFORE validating — else a garbage-frame flood dodges the cap entirely.",
   "lineHeight": 1.25,
   "baseline": 13
  },
