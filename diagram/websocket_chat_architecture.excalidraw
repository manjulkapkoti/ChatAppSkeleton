   "type": "rectangle",
   "id": "b1",
   "x": 90,
   "y": 1018,
   "width": 640,
   "height": 80,
   "section": "BROKER — swappable pub/sub port",
   "role": {
    "title": "ChatBroker",
    "text": "register/unregister/publish/close_user behind one interface. In-memory and single-process today; swap in a Redis/NATS-backed implementation when you run more than one process, with no caller changes. Also the mechanism behind immediate revocation.",
    "file": "backend/chat_broker.py"
   }
  },
  {
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 850684872,
   "version": 1,
   "versionNonce": 1357636986,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1784619688305,
   "link": null,
   "locked": false,
   "type": "text",
   "id": "b1_txt",
   "x": 152.5,
   "y": 1025.5,
   "width": 515,
   "height": 65,
   "text": "In-memory registry (single process) today →\nRedis / NATS pub-sub later — same interface, callers unchanged.\nAlso force-closes a LIVE socket the instant membership is revoked:\nrevoke() calls broker.close_user() directly.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "b1",
   "originalText": "In-memory registry (single process) today →\nRedis / NATS pub-sub later — same interface, callers unchanged.\nAlso force-closes a LIVE socket the instant membership is revoked:\nrevoke() calls broker.close_user() directly.",
   "lineHeight": 1.25,
   "baseline": 13
  },
