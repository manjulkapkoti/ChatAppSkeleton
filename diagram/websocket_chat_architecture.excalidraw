   "role": {
    "title": "Authenticate",
    "text": "Verifies the JWT passed as a query param — a browser can't attach a custom header to a WebSocket handshake, so the token travels there instead. Runs synchronously; invalid/missing/expired closes with code 4001.",
    "file": "backend/auth.py — verify_token()"
   }
  },
