   "text": "BROKER — swappable pub/sub port",
   "fontSize": 14,
   "width": 261,
   "height": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "BROKER — swappable pub/sub port",
   "lineHeight": 1.25,
   "baseline": 14
  },
  {
   "angle": 0,
   "strokeColor": "#22c55e",
   "backgroundColor": "#d3f9d8",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "dashed",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1984264291,
   "version": 1,
   "versionNonce": 343732758,
   "isDeleted": false,
   "boundElements": [
    {
